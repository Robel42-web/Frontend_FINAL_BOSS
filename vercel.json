{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://TU-API.onrender.com/api/:path*" },
    { "source": "/sanctum/:path*", "destination": "https://TU-API.onrender.com/sanctum/:path*" },
    { "source": "/auth/google/:path*", "destination": "https://TU-API.onrender.com/auth/google/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/api/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/sanctum/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/auth/google/:path*", "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] }
  ]
}